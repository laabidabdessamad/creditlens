# --- Streamlit UI (set in Streamlit Cloud > App settings > Secrets, or locally) ---
CREDITLENS_API_URL=https://creditlens-api.onrender.com

# --- API (optional overrides) ---
MODEL_PATH=models/credit_model.joblib
CORS_ORIGINS=*

# --- MLflow (default is a local SQLite store; point at DagsHub to share runs) ---
# MLFLOW_TRACKING_URI=https://dagshub.com/<user>/creditlens.mlflow
# MLFLOW_TRACKING_USERNAME=<dagshub-user>
# MLFLOW_TRACKING_PASSWORD=<dagshub-token>
